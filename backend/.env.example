# Port the backend listens on. Most hosts (Render, Railway, etc.) inject
# their own PORT — leave this as a local-dev fallback, don't hardcode it in
# production unless your host requires a specific value.
PORT=5000


# Your MongoDB connection string (Atlas or self-hosted). Must be reachable
# from wherever the backend is deployed, not just from your own machine.
MONGODB_URI=mongodb://127.0.0.1:27017/cvbuilder

# Long random secret used to sign login JWTs. Generate your own — e.g.
# `openssl rand -hex 32` — and never reuse the same value across
# environments (dev/staging/prod) or share it between people.
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# A SEPARATE long random secret for CSRF token signing — must not be the
# same value as JWT_SECRET. Generate independently (e.g. `openssl rand -hex
# 32`) and keep it private to this server.
CSRF_SECRET=your_separate_csrf_secret_change_in_production

# Only needed when the frontend and API are on DIFFERENT subdomains of the
# same registered domain (e.g. cv.example.com + apicv.example.com). Set it to
# the shared parent with a leading dot — .example.com — so the csrf-token and
# auth cookies are readable/sent across both. Leave unset (blank) for a
# same-origin deploy or when the API is proxied under the frontend's /api.
COOKIE_DOMAIN=

# The exact production URL of the deployed FRONTEND (protocol + domain, no
# trailing slash — e.g. https://app.example.com). Used for the CORS
# Access-Control-Allow-Origin check; credentialed cross-origin requests
# require this to match exactly, a wildcard will not work. In production
# this must be the real frontend's origin, not localhost.
CLIENT_URL=http://localhost:5173

# Cloudinary (optional - for profile photos)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL for PDF generation (Puppeteer loads the resume/cover-letter
# preview from this URL, so it must be the same deployed frontend as
# CLIENT_URL above and reachable from the backend's server). Falls back to
# CLIENT_URL if unset, so in most deployments you only need to set one of
# the two — set both explicitly if you're unsure.
FRONTEND_URL=http://localhost:5173

# Optional error monitoring (npm install @sentry/node if used)
SENTRY_DSN=

# Must be exactly "production" in your production deployment — this flags
# cookies as Secure + SameSite=None (required once the frontend and backend
# are on different domains) and enables other production-only behavior.
# Leave as "development" for local work.
NODE_ENV=development

# Optional: path to Chrome if not using bundled Puppeteer browser
# PUPPETEER_EXECUTABLE_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
