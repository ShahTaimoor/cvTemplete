# The exact production URL of the deployed BACKEND API (protocol + domain +
# /api, no trailing slash — e.g. https://api.example.com/api). Vite bakes
# this in at BUILD time, not runtime, so it must be set as an environment
# variable in your hosting platform's build settings (e.g. the Vercel/
# Netlify "Environment Variables" panel) before/during each deploy — editing
# a .env file on the server after the fact has no effect. If unset, the app
# falls back to a relative '/api' path, which only works when a dev proxy
# (like Vite's local one) or the same-origin server is handling it.
VITE_API_URL=http://localhost:5000/api
